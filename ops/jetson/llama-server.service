# Installed on node2 (orinnx) and node3 (orin1) as /etc/systemd/system/llama-server.service.
# Substitute the user per node; the model path and binary live in that user's start_llama.sh,
# so this unit is identical on both nodes apart from User= and the description.
#
#   sudo install -m 644 -o root -g root llama-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now llama-server
#
# VERIFIED on node3 2026-11-24: after a reboot the unit came back enabled+active with
# NRestarts=0, health 200, still serving the locally staged model, no intervention. It was
# serving 15 s after kernel start -- before SSH accepted connections again. A full reboot costs
# ~229 s on a Jetson here, but 87% of that is shutdown + Tegra firmware, not Linux (30.6 s).
#
# NOTE: kill any hand-started llama-server FIRST. An orphan holding ~10 GB will make the unit
# fail with "cudaMalloc failed: out of memory" -- it OOMs against the process it is replacing.
[Unit]
Description=llama-server (model staged on local NVMe)
Documentation=https://github.com/Hi5808/turing-pi-2-5-cluster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGEME
ExecStart=/bin/bash /home/CHANGEME/start_llama.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
# Cap shutdown. llama-server holds a large CUDA allocation and systemd's default 90 s stop
# timeout is a candidate for part of the ~199 s pre-Linux reboot cost measured in A43. With
# persistent journald (journald-persistent.conf) the next reboot's shutdown log will show
# whether this actually helps -- UNVERIFIED as of 2026-11-24.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
