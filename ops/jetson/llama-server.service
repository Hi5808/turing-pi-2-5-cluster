# Installed on node2 (orinnx) and node3 (orin1) as /etc/systemd/system/llama-server.service.
# Substitute the user per node; the model path and binary live in that user's start_llama.sh,
# so this unit is identical on both nodes apart from User= and the description.
#
#   sudo install -m 644 -o root -g root llama-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now llama-server
#
# VERIFIED on node3 2026-11-24: after a reboot the unit came back enabled+active with
# NRestarts=0, health 200, still serving the locally staged model, no intervention. It was
# serving 15 s after kernel start -- before SSH accepted connections again. A full reboot costs
# ~229 s on a Jetson here, but 87% of that is shutdown + Tegra firmware, not Linux (30.6 s).
#
# NOTE: kill any hand-started llama-server FIRST. An orphan holding ~10 GB will make the unit
# fail with "cudaMalloc failed: out of memory" -- it OOMs against the process it is replacing.
[Unit]
Description=llama-server (model staged on local NVMe)
Documentation=https://github.com/Hi5808/turing-pi-2-5-cluster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGEME
ExecStart=/bin/bash /home/CHANGEME/start_llama.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
# Cap shutdown. CONFIRMED by timing `systemctl stop` (selfmodel.db run 8b8a7eb57d8b): a
# long-running instance does NOT stop on SIGTERM -- it ran to this cap and needed SIGKILL
# ("result 'timeout'"). With systemd's DEFAULT 90 s, this one service stalls shutdown for 90 s
# every reboot, which is most of the ~199 s pre-Linux cost in A43.
#
# The trigger is an IN-FLIGHT STREAMING REQUEST, not instance age. Measured: idle 0.49 s,
# one completed request 0.24 s, 24 completed requests 0.24 s -- but a stream in flight stalls.
# ("Accumulated state" was my earlier guess and is wrong; the aged instances were stalling
# because the dashboard streams to them continuously.)
#
# An in-flight stream is NECESSARY but NOT SUFFICIENT, and it is NOT a build regression: a
# same-node A/B inverted the cross-node result, and stall length varies 30 s to >120 s, which
# looks like a race. Unseparated: --parallel, -c, model speed, bind address, and whether the
# signal arrives from systemd's cgroup or a direct kill.
#
# Do NOT set KillSignal=SIGINT. It was tried and is WORSE: SIGINT hit the 15 s cap on a fresh
# instance that SIGTERM stopped in 0.246 s.
#
# VERIFIED end to end by a second reboot (selfmodel.db run cc40cd8ca4a8): pre-Linux cost went
# 199 s -> 123 s (76 s saved, matching the prediction), and time to a serving endpoint went
# 214 s -> 141 s. The shutdown journal shows 'Stopping llama-server' 07:04:17 -> 'Stopped'
# 07:04:32: exactly 15 s, result 'timeout', and 94% of ALL OS shutdown time (16 s total).
#
# What is left is not ours: 107 s of Tegra firmware/bootloader, 66% of the whole reboot. Do not
# chase further OS-side shutdown tuning -- the floor is the firmware.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
